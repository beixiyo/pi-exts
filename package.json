{
  "name": "@jl-org/pi-exts",
  "version": "0.2.0",
  "description": "Extension bundle for the Pi coding agent: ask_user dialog tool, /yank picker, statusline with provider quotas, session auto-rename, mid-sentence slash completion, and more",
  "type": "module",
  "license": "MIT",
  "author": "CJL <2662442385@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beixiyo/pi-exts.git"
  },
  "homepage": "https://github.com/beixiyo/pi-exts#readme",
  "bugs": {
    "url": "https://github.com/beixiyo/pi-exts/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "statusline",
    "cli",
    "tui",
    "ai-agent"
  ],
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "lib",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://github.com/beixiyo/pi-exts/releases/download/v0.1.0/after.png"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^26.6.2",
    "typebox": "^1.3.7",
    "vitest": "^5.0.1"
  }
}
